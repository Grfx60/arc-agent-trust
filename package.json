{
  "name": "arc-agent-trust",
  "version": "2.0.0",
  "description": "Blockchain-based Agent Trust Assessment System for Arc Testnet",
  "main": "src/servers/live-api.js",
  "scripts": {
    "start": "node src/servers/dashboard.js & node src/servers/live-api.js",
    "start:dashboard": "node src/servers/dashboard.js",
    "start:api": "node src/servers/live-api.js",
    "start:both": "concurrently \"npm run start:dashboard\" \"npm run start:api\"",
    "test": "node test/utils.js",
    "test:arc": "node test/test-arc.js",
    "test:risk": "node test/test-risk-engine-v6.js",
    "analyze": "node src/engines/trust-engine.js",
    "lint": "eslint src/ --fix || true",
    "clean": "rm -rf .cache/ logs/ && mkdir -p logs"
  },
  "keywords": ["blockchain", "agent", "trust", "arc-testnet"],
  "author": "Arc Trust Team",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "viem": "^2.55.19",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}

