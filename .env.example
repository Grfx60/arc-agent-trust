# Arc Agent Trust - Environment Configuration
# Copy to .env and update with your values

# ============================================
# SERVER CONFIGURATION
# ============================================
DASHBOARD_PORT=3000
DASHBOARD_HOST=0.0.0.0
LIVE_API_PORT=3100
LIVE_API_HOST=0.0.0.0

# ============================================
# BLOCKCHAIN CONFIGURATION
# ============================================
BLOCKCHAIN_NETWORK=Arc Testnet
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_SCAN_API=https://api-testnet.arc-scan.org
IDENTITY_REGISTRY=0x8004A818BFB912233c491871b3d84c89A494BD9e
VALIDATOR_REGISTRY=0x8004Cb1BF31DAf7788923b405b754f57acEB4272

# ============================================
# STORAGE CONFIGURATION
# ============================================
EVIDENCE_DIR=./evidence
REPORT_DIR=./reports
CACHE_DIR=./.cache

# ============================================
# TRUST ENGINE CONFIGURATION
# ============================================
PRIMARY_AGENT_ID=845265

# Risk score thresholds
RISK_ALLOW=20
RISK_REVIEW=50
RISK_BLOCK=75

# Confidence thresholds
CONF_HIGH=75
CONF_MEDIUM=50
CONF_LOW=25

# ============================================
# LOGGING CONFIGURATION
# ============================================
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE=./logs/app.log

# ============================================
# FEATURE FLAGS
# ============================================
ENABLE_CACHE=true
ENABLE_LOGGING=true
ENABLE_GRAPH=true
ENABLE_VALIDATOR=true
DEBUG=false
