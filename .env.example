# Arc Agent Trust - Environment Configuration
# Copy to .env and update with your values

# ============================================
# SERVER CONFIGURATION
# ============================================
DASHBOARD_PORT=3000
DASHBOARD_HOST=0.0.0.0
LIVE_API_PORT=3100
LIVE_API_HOST=0.0.0.0

# ============================================
# BLOCKCHAIN CONFIGURATION
# ============================================
BLOCKCHAIN_NETWORK=Arc Testnet
ARC_RPC_URL=https://testnet.arcdev.io/rpc
IDENTITY_REGISTRY=0x8004be9A59F5Bd7B2F87Be6A8CdE1aF6d6F5cA3a
VALIDATOR_REGISTRY=0xE18F822B5c965D84a65f6b3aaCc8DfF5dEe6Ff8f

# ============================================
# STORAGE CONFIGURATION
# ============================================
EVIDENCE_DIR=./evidence
REPORT_DIR=./reports
CACHE_DIR=./.cache

# ============================================
# TRUST ENGINE CONFIGURATION
# ============================================
PRIMARY_AGENT_ID=845265

# Risk score thresholds
RISK_ALLOW=20
RISK_REVIEW=50
RISK_BLOCK=75

# Confidence thresholds
CONF_HIGH=75
CONF_MEDIUM=50
CONF_LOW=25

# ============================================
# LOGGING CONFIGURATION
# ============================================
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE=./logs/app.log

# ============================================
# FEATURE FLAGS
# ============================================
ENABLE_CACHE=true
ENABLE_LOGGING=true
ENABLE_GRAPH=true
ENABLE_VALIDATOR=true
DEBUG=false
